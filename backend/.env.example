# Application Settings
APP_NAME=PromoNxtAI
ENV=development
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# AI Models & API Keys (deck defaults)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2

# Supabase Database & Storage Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# n8n Automation Webhook & Security
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/instagram-publish
N8N_SHARED_SECRET=your_n8n_shared_secret_here
