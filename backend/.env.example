# Application Settings
APP_NAME=PromoNxtAI
ENV=development
DEBUG=True
USE_SAMPLE_DATA=True
IMAGE_MOCK=True
N8N_MOCK=True
LLM_MOCK=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
OPENROUTER_SITE_URL=https://promonxtai.com
OPENROUTER_SITE_NAME=PromoNxtAI

# Supabase Database & Storage Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# n8n Automation Webhook & Security
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/instagram-publish
N8N_SHARED_SECRET=your_n8n_shared_secret_here
